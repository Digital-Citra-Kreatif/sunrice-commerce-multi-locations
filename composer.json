{
    "name": "sunrice/commerce-multi-locations",
    "description": "Multiple locations for Sunrice Commerce: warehouses, shops and pickup points, stock per location, transfers, shipping from the location that has the goods and pickup at any of them.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sunrice",
        "laravel",
        "ecommerce",
        "inventory",
        "warehouse",
        "multi-location"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "sunrice/commerce": "^0.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Sunrice\\CommerceMultiLocations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\CommerceMultiLocations\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\CommerceMultiLocations\\MultiLocationsServiceProvider"
            ],
            "sunrice-plugins": [
                "Sunrice\\CommerceMultiLocations\\MultiLocationsPlugin"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
